# Postgres (Neon). Na Vercel é criada sozinha ao conectar o banco (Storage > Neon).
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Senha longa e aleatória. Vai na URL dos webhooks do Clint e em /api/setup. Também assina as sessões.
WEBHOOK_SECRET=troque-por-uma-senha-longa

# Primeiro acesso do gestor (só funciona enquanto não existir nenhum gestor cadastrado)
DASHBOARD_USER=vinicius
DASHBOARD_PASSWORD=troque-esta-senha
DASHBOARD_NOME=Vinicius Paiva
